<style>
  * {
  	margin: 0;
    transform-style: preserve-3d;
  }

  #world { 
    perspective: 800px;
  	width: 100vw;
    height: 100vh;
    display:flex;
    align-content: center;
    text-align: center;
    overflow: hidden;
  }
	.face {
		position: absolute;
		width: 100px;
    height: 100px;
    line-height: 100px;

	}
  #camera {
  	position:relative;
  	width: 100vw;
    height: 100vh;
    transform-origin: center center 800px;
  }
  #box-wrapper {
  	position:relative;
  	width: 100vw;
    height: 100vh;
  }
  #box{
  	position:fixed;
  	width:100px;
    height:100px;
    left:45vw;
    top:45vh;
  	transform-origin: center center center;
    background-color:black;
  }
  #front {
  	background-color:rgb(0 255 161 / 70%);
    transform: translate3d(0,0,50px);
  }
  #bottom {
  	background-color:rgb(0 46 255 / 70%);
    transform: rotateX(-90deg) translate3d(0,0,50px);
  }
  #back {
  	background-color:rgb(255 153 11 / 70%);
    transform: rotateY(180deg) translate3d(0,0,50px) ;
  }
  #top {
  	background-color:rgb(251 255 0 / 70%);
    transform: rotateX(90deg) translate3d(0,0,50px) ;
  }
  #right {
  	background-color:rgb(128 0 255 / 70%);
    transform: rotateY(90deg) translate3d(0,0,50px) ;
  }
  #left {
  	background-color:rgb(255 0 135 / 70%);
    transform: rotateY(-90deg) translate3d(0,0,50px) ;
  }
</style>
<body>
<div id="world">
  <div id="camera">
    <div id="box-wrapper">
      <div id="box">
        <div class="face" id="front">front</div>
        <div class="face" id="top">top</div>
        <div class="face" id="back">back</div>
        <div class="face" id="bottom">bottom</div>
        <div class="face" id="right">right</div>
        <div class="face" id="left">left</div>
      </div>
    </div>
  </div>
</div>
</body>
<script>
	const box = document.getElementById("box"),
  		  keyBinds = {"w":0,"a":0,"s":0,"d":0,"q":0,"e":0,"f":0,"t":0,"g":0,"h":0,"r":0,"y":0,"ArrowLeft":0,"ArrowRight":0};
  
	document.onkeydown = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 1 : 0;
  document.onkeyup = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 0 : 0;  
  let curCubeAngles = [0,0,0],
      curCamOffset = [0,0,0],
      curCamAngle = 0;
	setInterval(() => {
    let netWS = keyBinds.w - keyBinds.s,
        netAD = keyBinds.a - keyBinds.d,
        netQE = keyBinds.q - keyBinds.e,
    		netTG = keyBinds.t - keyBinds.g,
        netFH = keyBinds.f - keyBinds.h,
        netRY = keyBinds.r - keyBinds.y,
    		netArrow = keyBinds.ArrowRight - keyBinds.ArrowLeft;
    		curCamOffset[0] += netAD*5;
    		curCamOffset[1] += netQE*5;
    		curCamOffset[2] += netWS*5;
    		curCubeAngles[0] += netTG*5;
    		curCubeAngles[1] += netFH*5;
    		curCubeAngles[2] += netRY*5;
    		curCamAngle += netArrow*5;
    		box.parentElement.style.transform = "translate3d(" + curCamOffset[0] + "px," + curCamOffset[1] + "px," + curCamOffset[2] + "px)";
        box.style.transform = "rotate3d(1,0,0," + curCubeAngles[0] + "deg) rotate3d(0,1,0," + curCubeAngles[1] + "deg) rotate3d(0,0,1," + curCubeAngles[2] + "deg)";
				box.parentElement.parentElement.style.transform = "rotateY(" + curCamAngle + "deg)";
  }, 100);
</script>
