<style>
  * {
  	margin: 0;
    transform-style: preserve-3d;
  }

  #world { 
    perspective: 800px;
  	width: 100vw;
    height: 100vh;
    display:flex;
    align-content: center;
    text-align: center;
    overflow: hidden;
  }
  #camera {
  	position:relative;
  	width: 100vw;
    height: 100vh;
    transform-origin: center center 800px;
  }
  #box-wrapper {
  	position:relative;
  	width: 100vw;
    height: 100vh;
  }
  .box{
  	position:fixed;
  	width:100px;
    height:100px;
    left:45vw;
    top:45vh;
  	transform-origin: center center center;
    background-color:black;
  }
  .front {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(0 255 161 / 70%);
    transform: translate3d(-50px,0,50px);
  }
  .bottom {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(0 46 255 / 70%);
    transform: rotateX(-90deg) translate3d(-50px,0,50px);
  }
  .back {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(255 153 11 / 70%);
    transform: rotateY(180deg) translate3d(50px,0,50px) ;
  }
  .top {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(251 255 0 / 70%);
    transform: rotateX(90deg) translate3d(-50px,0,50px) ;
  }
  .right {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(128 0 255 / 70%);
    transform: rotateY(90deg) translate3d(0,0,0) ;
  }
  .left {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(255 0 135 / 70%);
    transform: rotateY(-90deg) translate3d(0,0,100px) ;
  }
</style>
<body>
<div id="world">
  <div id="camera">
    <div id="box-wrapper">
      <div class="box">
        <canvas class="front"></canvas>
        <canvas class="back"></canvas>
        <canvas class="top"></canvas>
        <canvas class="bottom"></canvas>
        <canvas class="right"></canvas>
        <canvas class="left"></canvas>
      </div>
    </div>
  </div>
</div>
</body>
<script>
	const box_wrapper = document.getElementById("box-wrapper"),
        tempfrontctx = box_wrapper.children[0].children[0].getContext("2d"),
        tempbackctx = box_wrapper.children[0].children[1].getContext("2d"),
        temptopctx = box_wrapper.children[0].children[2].getContext("2d"),
        tempbottomctx = box_wrapper.children[0].children[3].getContext("2d"),
        temprightctx = box_wrapper.children[0].children[4].getContext("2d"),
        templeftctx = box_wrapper.children[0].children[5].getContext("2d"),
  		  keyBinds = {"w":0,"a":0,"s":0,"d":0,"q":0,"e":0,"f":0,"t":0,"g":0,"h":0,"r":0,"y":0,"ArrowLeft":0,"ArrowRight":0};
			
  
  		tempfrontctx.width = tempfrontctx.height = 100;
  		console.log(tempfrontctx.width, tempfrontctx.height);
  		tempfrontctx.fillRect(25,25,50,50);
class Box {
  	xLen;
  	yLen;
  	zLen;
    box;
  	faceCanvases = [];//frontCanvas, backCanvas, topCanvas, bottomCanvas, rightCanvas, leftCanvas
    
    constructor(xLen,yLen, zLen, midPointCoords, xyzRotationAngles){
      this.xLen = xLen;
      this.yLen = yLen;
      this.zLen = zLen;
    	this.box = box_wrapper.children[0].cloneNode(true);
      this.box.style.transform = "scale3d(" + (xLen/100) + "," + (yLen/100) + "," + (zLen/100) + ") rotate3d(1,0,0," + xyzRotationAngles[0] + "deg) rotate3d(0,1,0," + xyzRotationAngles[1] + "deg) rotate3d(0,0,1," + xyzRotationAngles[2] + "deg) translate3d(" + midPointCoords[0] + "px, " + midPointCoords[1] + "px, " + midPointCoords[2] + "px)";
  		box_wrapper.appendChild(this.box);
      for(let i = 0; i < 6; ++i){
      	this.faceCanvases[i] = this.box.children[i].getContext("2d");
      }
      this.faceCanvases[0].width = this.faceCanvases[1].width = this.faceCanvases[2].width = this.faceCanvases[3].width = xLen;
      this.faceCanvases[0].height = this.faceCanvases[1].height = this.faceCanvases[4].height = this.faceCanvases[5].height = yLen;
      this.faceCanvases[2].height = this.faceCanvases[3].height = this.faceCanvases[4].width = this.faceCanvases[5].width = zLen;
    	this.cloneCanvasToScale();
    }
  
  	cloneCanvasToScale(){
      for(let numWidth = 0; numWidth < Math.ceil(this.xLen/100); ++numWidth){
        for(let numHeightFrontBack = 0; numHeightFrontBack < Math.ceil(this.yLen/100); ++numHeightFrontBack){
          this.faceCanvases[0].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightFrontBack);
          this.faceCanvases[1].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightFrontBack);
        }
        for(let numHeightTopBottom = 0; numHeightTopBottom < Math.ceil(this.zLen/100); ++numHeightTopBottom){
					this.faceCanvases[2].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightTopBottom);
          this.faceCanvases[3].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightTopBottom);
        }
      }
      for(let numWidthRightLeft = 0; numWidthRightLeft < Math.ceil(this.zLen/100); ++numWidthRightLeft){
        for(let numHeightRightLeft = 0; numHeightRightLeft < Math.ceil(this.yLen/100); ++numHeightRightLeft){
					this.faceCanvases[2].drawImage(box_wrapper.children[0].children[0],100*numWidthRightLeft,100*numHeightRightLeft);
        	this.faceCanvases[3].drawImage(box_wrapper.children[0].children[0],100*numWidthRightLeft,100*numHeightRightLeft);
        }
      }
    }
	}
  objs = [/*new Box(1000,1000,1000,[0,0,0],[0,0,0]),*/new Box(100,100,100,[0,200,0],[90,0,0])];
  
	document.onkeydown = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 1 : 0;
  document.onkeyup = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 0 : 0;  
  
  //Delete curCubeAngles and all the keybinds assoiciated with it when done testing
  let curCubeAngles = [0,0,0],
      curCamOffset = [0,0,0],
      curCamAngle = 0;
	setInterval(() => {
    let netWS = keyBinds.w - keyBinds.s,
        netAD = keyBinds.a - keyBinds.d,
        netQE = keyBinds.q - keyBinds.e,
    		netTG = keyBinds.t - keyBinds.g,
        netFH = keyBinds.f - keyBinds.h,
        netRY = keyBinds.r - keyBinds.y,
    		netArrow = keyBinds.ArrowRight - keyBinds.ArrowLeft;
        curCamAngle += netArrow*5;
    		curCamOffset[0] += netAD*5*Math.cos(curCamAngle*(Math.PI/180))-netWS*5*Math.sin(curCamAngle*(Math.PI/180));
    		curCamOffset[1] += netQE*5;
    		curCamOffset[2] += netAD*5*Math.sin(curCamAngle*(Math.PI/180))+netWS*5*Math.cos(curCamAngle*(Math.PI/180));
    		curCubeAngles[0] += netTG*5;
    		curCubeAngles[1] += netFH*5;
    		curCubeAngles[2] += netRY*5;
    		box_wrapper.style.transform = "translate3d(" + curCamOffset[0] + "px," + curCamOffset[1] + "px," + curCamOffset[2] + "px)";
        box_wrapper.children[0].style.transform = "scale3d(1,1,1) rotate3d(1,0,0," + curCubeAngles[0] + "deg) rotate3d(0,1,0," + curCubeAngles[1] + "deg) rotate3d(0,0,1," + curCubeAngles[2] + "deg)";
				box_wrapper.parentElement.style.transform = "rotateY(" + curCamAngle + "deg)";
  }, 100);
</script>
