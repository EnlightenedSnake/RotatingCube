<style>
  * {
  	margin: 0;
    transform-style: preserve-3d;
  }

  #world { 
    perspective: 800px;
  	width: 100vw;
    height: 100vh;
    display:flex;
    align-content: center;
    text-align: center;
    overflow: hidden;
  }
  #camera {
  	position:relative;
  	width: 100vw;
    height: 100vh;
    transform-origin: center center 800px;
  }
  #box-wrapper {
  	position:relative;
  	width: 100vw;
    height: 100vh;
  }
  .box{
  	position:fixed;
  	width:100px;
    height:100px;
    left:45vw;
    top:45vh;
  	transform-origin: center center center;
    background-color:black;
  }
  .front {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(0 255 161 / 70%);
    transform: translate3d(-50px,0,50px);
  }
  .bottom {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(0 46 255 / 70%);
    transform: rotateX(-90deg) translate3d(-50px,0,50px);
  }
  .back {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(255 153 11 / 70%);
    transform: rotateY(180deg) translate3d(50px,0,50px) ;
  }
  .top {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(251 255 0 / 70%);
    transform: rotateX(90deg) translate3d(-50px,0,50px) ;
  }
  .right {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(128 0 255 / 70%);
    transform: rotateY(90deg) translate3d(0,0,0) ;
  }
  .left {
  	position: absolute;
  	width: 100px;
    height: 100px;
  	background-color:rgb(255 0 135 / 70%);
    transform: rotateY(-90deg) translate3d(0,0,100px) ;
  }
</style>
<body>
<div id="world">
  <div id="camera">
    <div id="box-wrapper">
      <div class="box">
        <canvas class="front"></canvas>
        <canvas class="back"></canvas>
        <canvas class="top"></canvas>
        <canvas class="bottom"></canvas>
        <canvas class="right"></canvas>
        <canvas class="left"></canvas>
      </div>
    </div>
  </div>
</div>
</body>
<script>
	const box_wrapper = document.getElementById("box-wrapper"),
        tempfrontctx = box_wrapper.children[0].children[0].getContext("2d"),
        tempbackctx = box_wrapper.children[0].children[1].getContext("2d"),
        temptopctx = box_wrapper.children[0].children[2].getContext("2d"),
        tempbottomctx = box_wrapper.children[0].children[3].getContext("2d"),
        temprightctx = box_wrapper.children[0].children[4].getContext("2d"),
        templeftctx = box_wrapper.children[0].children[5].getContext("2d"),
  		  keyBinds = {"w":0,"a":0,"s":0,"d":0,"q":0,"e":0,"f":0,"t":0,"g":0,"h":0,"r":0,"y":0,"ArrowLeft":0,"ArrowRight":0};
			
  
  //Setting default face canvases
  	//Front
  		box_wrapper.children[0].children[0].width = box_wrapper.children[0].children[0].height = 100;
  		tempfrontctx.fillRect(25,25,50,50);
class Box {
  	xLen;
  	yLen;
  	zLen;
    box;
  	faceCanvases = [];//frontCanvas, backCanvas, topCanvas, bottomCanvas, rightCanvas, leftCanvas
    
    constructor(xLen,yLen, zLen, midPointCoords, xyzRotationAngles){
      this.xLen = xLen;
      this.yLen = yLen;
      this.zLen = zLen;
    	this.box = box_wrapper.children[0].cloneNode(true);
      this.box.style.transform = "rotate3d(1,0,0," + xyzRotationAngles[0] + "deg) rotate3d(0,1,0," + xyzRotationAngles[1] + "deg) rotate3d(0,0,1," + xyzRotationAngles[2] + "deg) translate3d(" + midPointCoords[0] + "px, " + midPointCoords[1] + "px, " + midPointCoords[2] + "px) scale3d(" + (xLen/100) + "," + (yLen/100) + "," + (zLen/100) + ")";
  		box_wrapper.appendChild(this.box);
      for(let i = 0; i < 6; ++i){
      	this.faceCanvases[i] = this.box.children[i].getContext("2d");
      }
      this.box.children[0].width = this.box.children[1].width = this.box.children[2].width = this.box.children[3].width = xLen;
      this.box.children[0].height = this.box.children[1].height = this.box.children[4].height = this.box.children[5].height = yLen;
      this.box.children[2].height = this.box.children[3].height = this.box.children[4].width = this.box.children[5].width = zLen;
    	this.cloneCanvasToScale();
    }
  
  	cloneCanvasToScale(){
      for(let numWidth = 0; numWidth < Math.ceil(this.xLen/100); ++numWidth){
        for(let numHeightFrontBack = 0; numHeightFrontBack < Math.ceil(this.yLen/100); ++numHeightFrontBack){
          this.faceCanvases[0].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightFrontBack);
          this.faceCanvases[1].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightFrontBack);
        }
        for(let numHeightTopBottom = 0; numHeightTopBottom < Math.ceil(this.zLen/100); ++numHeightTopBottom){
					this.faceCanvases[2].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightTopBottom);
          this.faceCanvases[3].drawImage(box_wrapper.children[0].children[0],100*numWidth,100*numHeightTopBottom);
        }
      }
      for(let numWidthRightLeft = 0; numWidthRightLeft < Math.ceil(this.zLen/100); ++numWidthRightLeft){
        for(let numHeightRightLeft = 0; numHeightRightLeft < Math.ceil(this.yLen/100); ++numHeightRightLeft){
					this.faceCanvases[4].drawImage(box_wrapper.children[0].children[0],100*numWidthRightLeft,100*numHeightRightLeft);
        	this.faceCanvases[5].drawImage(box_wrapper.children[0].children[0],100*numWidthRightLeft,100*numHeightRightLeft);
        }
      }
    }
	}
class Sector {
		order;
  	corners;
  	sides;
  	zUpperBound;
  	zLowerBound;
  	neighbors;
  
  	constructor(corners, lowestZ, height, order, neighbors){
    	this.order = order;
      this.corners = corners;
      this.zLowerBound = lowestZ;
      this.zUpperBound = lowestZ+height;
      this.neighbors = neighbors;
      this.sides = new Array(corners.length);
      for (let i = 0; i < corners.length - 1; ++i) this.sides[i] = [corners[i+1][0]-corners[i][0],corners[i+1][1]-corners[i][1]];
      this.sides[corners.length - 1] = [corners[0][0]-corners[corners.length-1][0],corners[0][1]-corners[corners.length-1][1]];
    }
  	
  	isInside(point){
      if(point[1] < this.zLowerBound || point[1] > this.zUpperBound) return false; 
  		let count = 0;
      for(let i = 0; i < this.corners.length; ++i){
       	let zLengthPorportion = (point[2]-this.corners[i][1])/this.sides[i][1],
            intersect = false; 
        if(zLengthPorportion >= 0 && zLengthPorportion <= 1) intersect = this.corners[i][0]-point[0]+this.sides[i][0]*zLengthPorportion >= 0;
      	if(intersect) count++;
      }
      if((count%2) == 0){
      	for(let i = 0; i < this.corners.length; ++i){
        	if(point[0] == this.corners[i][0] && point[2] == this.corners[i][1]) return true;
        }
      }
      return count % 2 == 1;
    }
  	
  	moveSector(pos){
    	if(this.isInside(pos)) return [true,null];
      for(let i = 0; i < this.neighbors.length; ++i){
      	if(sectors[this.neighbors[i]].isInside(pos)) return [true, sectors[this.neighbors[i]]];
      }
      return [false, null];
    }
}
  function move(dx,dy,dz){
  	let res = curSector.moveSector([curCamPos[0]+dx,curCamPos[1]+dy,curCamPos[2]+dz]);
    if(res[0]){
    	curCamPos = [curCamPos[0]+dx,curCamPos[1]+dy,curCamPos[2]+dz];
      if(res[1] != null){
      	curSector = res[1]; 
      }
    }
  }
  objs = [new Box(1000,1000,1000,[0,0,800],[0,0,0]),new Box(100,100,100,[0,0,0],[90,0,0])];
  sectors = [new Sector([[-50,-50],[50,-50],[50,50],[-50,50]],-50, 100,[1,0],[])];
	document.onkeydown = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 1 : 0;
  document.onkeyup = e => Object.keys(keyBinds).includes(e.key) ? keyBinds[e.key] = 0 : 0;  
  
  //Delete curCubeAngles and all the keybinds assoiciated with it when done testing
  let curCubeAngles = [0,0,0],
      curCamPos = [0,0,0],
      curCamAngle = 0,
      curSector = sectors[0],
      turnSpeed = 5,
      moveSpeed = 5;
	setInterval(() => {
    let netWS = keyBinds.w - keyBinds.s,
        netAD = keyBinds.a - keyBinds.d,
        netQE = keyBinds.q - keyBinds.e,
    		netTG = keyBinds.t - keyBinds.g,
        netFH = keyBinds.f - keyBinds.h,
        netRY = keyBinds.r - keyBinds.y,
    		netArrow = keyBinds.ArrowRight - keyBinds.ArrowLeft;
        curCamAngle += netArrow*turnSpeed;
    		move(netAD*moveSpeed*Math.cos(curCamAngle*(Math.PI/180))-netWS*5*Math.sin(curCamAngle*(Math.PI/180)),netQE*moveSpeed,netAD*moveSpeed*Math.sin(curCamAngle*(Math.PI/180))+netWS*5*Math.cos(curCamAngle*(Math.PI/180)));
    		curCubeAngles[0] += netTG*5;
    		curCubeAngles[1] += netFH*5;
    		curCubeAngles[2] += netRY*5;
    		box_wrapper.style.transform = "translate3d(" + curCamPos[0] + "px," + curCamPos[1] + "px," + curCamPos[2] + "px)";
        box_wrapper.children[0].style.transform = "scale3d(1,1,1) rotate3d(1,0,0," + curCubeAngles[0] + "deg) rotate3d(0,1,0," + curCubeAngles[1] + "deg) rotate3d(0,0,1," + curCubeAngles[2] + "deg)";
				box_wrapper.parentElement.style.transform = "rotateY(" + curCamAngle + "deg)";
  }, 100);
</script>
